PORT=1511
API_BASE_URL=https://findmoney.fingoal.com/v3

CLIENT_ID=my_client_id
CLIENT_SECRET=my_client_secret
TENANT_ID=your_tenant_id

WEBHOOK_TYPE=USER_TAGS_DATA
CALLBACK_URL=https://your-ngrok-host.ngrok-free.app/v1/datarich-tags-receiver

# Defaults to the last 4 characters of CLIENT_SECRET when omitted.
WEBHOOK_SIGNING_SECRET=

# Optional. Set true to run the full auth/register/test flow when the server starts.
AUTO_RUN_ON_START=true
E2E_TIMEOUT_MS=30000
